# Copy to .env and fill in. See README.md and AUTONOMOUS_AGENT.md for the
# full explanation of every setting below.

# ── Reasoning backend ─────────────────────────────────────────────────────
# Which reasoning backend the agent uses:
#   cli (default) — shells out to the `claude` CLI headlessly (`claude -p`).
#     Runs on your logged-in Claude Pro/Max subscription — no separate API
#     billing. Requires Claude Code installed and logged in (`claude`, then
#     `/login`). If headless calls fail even though the interactive CLI
#     works, run `claude setup-token` once and set CLAUDE_CODE_OAUTH_TOKEN.
#   api — calls the Anthropic API directly, pay-per-token (needs
#     ANTHROPIC_API_KEY below). Useful for higher throughput/parallelism or
#     environments with no interactive login available.
CLAUDE_BACKEND=cli
# ANTHROPIC_API_KEY=your_anthropic_key_here   # only needed if CLAUDE_BACKEND=api
# CLAUDE_CODE_OAUTH_TOKEN=                    # only if `claude setup-token` was required — see above

# Model + effort default to a subscription-usage-conscious pairing on the
# `cli` backend (claude-sonnet-5 / medium) rather than the most expensive
# tier, since every call here spends against your Pro/Max usage window, not
# a pay-per-token bill. Raise CLAUDE_MODEL to claude-opus-5 for the most
# capable scoring if you're on CLAUDE_BACKEND=api or a Max plan.
CLAUDE_MODEL=claude-sonnet-5
# Cheaper model for a first-pass triage score over a large batch of new
# postings before the full match/decision pass runs on survivors. Leave
# unset to always use CLAUDE_MODEL.
# CLAUDE_TRIAGE_MODEL=claude-haiku-4-5
CLAUDE_EFFORT=medium

# ── Search scope ──────────────────────────────────────────────────────────
JOB_SEARCH_COUNTRY="United States"
REMOTE_ALLOWED=true
HYBRID_ALLOWED=true
ONSITE_ALLOWED=true

# ── Safety switches ───────────────────────────────────────────────────────
# When true, the agent does everything (score, tailor, fill forms) but
# never clicks Submit. Keep this true until you've reviewed a run's output.
DRY_RUN=true

# Master switch for the guarded auto-submit path. Even when true,
# auto-submit only fires for CAPTCHA-free ATS forms (Greenhouse/Lever/
# Ashby only), score >= AUTO_APPLY_THRESHOLD, and under
# MAX_APPLICATIONS_PER_DAY. Every LinkedIn application and every form with
# an ambiguous/legal/demographic field always goes to HUMAN_REVIEW
# regardless of this flag.
AUTO_APPLY_ENABLED=false

# 0-100 scale. Below this score the agent skips or asks; at/above it, a job
# is eligible for tailoring + (if AUTO_APPLY_ENABLED and DRY_RUN=false)
# auto-apply.
AUTO_APPLY_THRESHOLD=80

MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_HOUR=5
SEARCH_INTERVAL_MINUTES=30

# ── Optional notifications ────────────────────────────────────────────────
# Omit any you don't want. Console logging always happens regardless.
# NOTIFY_WEBHOOK_URL=https://hooks.slack.com/services/...
# NOTIFY_EMAIL_TO=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app_password_here

# ── Paths / misc ──────────────────────────────────────────────────────────
# Gitignored; created on first run.
# AGENT_DB_PATH=agent/data/agent.db
# AGENT_DASHBOARD_PORT=4141
